  {
    "id": "cvpr26-1478c23d0a8e",
    "extraction": {
      "id": "cvpr26-1478c23d0a8e",
      "figure": "Figure 3",
      "caption": "Figure 3. Our proposed JoPPO unifies attribute and overall assessment through joint Gaussian conditional modeling, computing the relative winning probabilities among different candidates conditioned on multiple attributes. This enables the model to learn effective ranking under complex multi-attribute composite evaluation scenarios, thereby significantly enhancing its overall evaluation performance.",
      "page": 5,
      "captionRect": [
        58.5,
        324.38299560546875,
        553.4990234375,
        355.26739501953125
      ],
      "score": -23,
      "scoreReasons": [
        "overall:+5",
        "performance:-8",
        "no strong model-structure evidence:-20"
