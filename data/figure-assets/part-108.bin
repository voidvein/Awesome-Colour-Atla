  {
    "id": "cvpr26-6318db9111e4",
    "extraction": {
      "id": "cvpr26-6318db9111e4",
      "figure": "Figure 1",
      "caption": "Figure 1. (a) An overview of the MCToGene framework. H&E WSIs are split into spot patches with coordinates; patch features are used to predict spot-level gene expression. (b) On a sparsiﬁed spot graph, pairwise attention aggregates neighbors and a Readout summarizes local context; many-body attention models high-order cross-cell interactions. A ﬂow-matching decoder reﬁnes predictions over timesteps.",
      "page": 3,
      "captionRect": [
        58.5,
        310.15966796875,
        553.4987182617188,
        341.0440673828125
      ],
      "score": 30,
      "scoreReasons": [
        "framework:+9",
        "overview:+7",
        "decoder:+2",
        "architecture in caption lead:+12"
      ],
      "captionFontSize": 8.97,
