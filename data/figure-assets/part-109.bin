    "extraction": {
      "id": "cvpr26-e5774ad580ed",
      "figure": "Figure 2",
      "caption": "Figure 2. E2-SCI edge cloud speculative decoding framework. System maps historical pass rates to distribution tolerance Tt adapting verification strictness. Asynchronous lookahead decou- ples edge drafting and cloud verification eliminating wait latency.",
      "page": 4,
      "captionRect": [
        50.11199951171875,
        373.8183288574219,
        286.36468505859375,
        417.3424072265625
      ],
      "score": 24,
