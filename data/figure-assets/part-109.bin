  {
    "id": "cvpr26-da3c08ad5dd0",
    "extraction": {
      "figure": "Figure 2",
      "caption": "Figure 2 : Overall framework of DeformPIC. Our model consists of two core components. The Deformation Extraction Network (DEN) extracts the geometric transformation from an example pair (prompt input→prompt target) into a task embedding. This embedding then modulates the Deformation Transfer Network (DTN), thereby guiding it to apply the same transformation to a new query input to produce the final prediction. The entire network is trained by minimizing the Chamfer Distance [ 9 ] against the ground truth.",
      "image_url": "https://arxiv.org/html/2604.02845v1/framework.png",
      "figureAnchor": "S2.F2",
      "panelIndex": 0,
      "panelCount": 1,
      "score": 32,
