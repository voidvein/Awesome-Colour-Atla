  {
    "id": "cvpr26-5565fdc69604",
    "extraction": {
      "id": "cvpr26-5565fdc69604",
      "figure": "Figure 2",
      "caption": "Figure 2. The proposed ResAD framework. Instead of predicting the entire trajectory, ResAD establishes a physical prior based on the vehicle’s current state: the Inertial Reference. By applying Inertial Reference Perturbation, the framework generates a diverse set of initial intent hypotheses. Finally, the diffusion decoder (DiffDecoder), conditioned on these references, learns to predict the necessary Normalized Residuals. We highlight the 1st-ranked and 5th-ranked output trajectories, denote as Top-1 Traj and Top-5 Traj.",
      "page": 3,
      "captionRect": [
        58.5,
        285.4347839355469,
        553.4990844726562,
        327.3553466796875
      ],
      "score": 23,
