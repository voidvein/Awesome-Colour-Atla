    "extraction": {
      "figure": "Figure 6",
      "caption": "Figure 6 : Overview of our method: Given the image and user’s query, we first leverage MCoT model’s internal visual entropy to detect divergent thinking steps. When the model is identified as thinking divergently, we further\nuse this score to dynamically intervene in the decoding process and mitigate hallucinations.",
      "image_url": "https://arxiv.org/html/2603.27201v1/model_new.png",
      "figureAnchor": "S4.F6",
      "panelIndex": 0,
      "panelCount": 1,
