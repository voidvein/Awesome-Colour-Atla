        "overview:+7",
        "encoder:+2",
        "decoder:+2",
        "architecture in caption lead:+12",
        "named model overview:+14"
      ],
      "captionFontSize": 8.97,
      "source_url": "https://openaccess.thecvf.com/content/CVPR2026/papers/Liu_TUNA_Taming_Unified_Visual_Representations_for_Native_Unified_Multimodal_Models_CVPR_2026_paper.pdf",
      "sourcePdf": "research/batch500/cache/cvpr26-2b208a25d78f.pdf",
      "image": "research/batch500/candidates/cvpr26-2b208a25d78f/cvpr26-2b208a25d78f.png",
