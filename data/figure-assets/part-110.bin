  {
    "id": "cvpr26-2b208a25d78f",
    "extraction": {
      "id": "cvpr26-2b208a25d78f",
      "figure": "Figure 2",
      "caption": "Figure 2. Overview of the TUNA architecture. Our model employs a VAE encoder and a representation encoder to construct unified visual representations, which are then combined with text tokens and processed by an LLM decoder. The decoder performs autoregressive text generation for understanding tasks and flow-matching-based visual generation for generation tasks. ∗During visual generation, noise is added to the visual tokens to enable diffusion-based generation.",
      "page": 3,
      "captionRect": [
        58.5,
        312.2249755859375,
        553.5026245117188,
        354.0673828125
      ],
      "score": 47,
      "scoreReasons": [
