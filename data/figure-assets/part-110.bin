  {
    "id": "cvpr26-2bd8e988ac34",
    "extraction": {
      "id": "cvpr26-2bd8e988ac34",
      "figure": "Figure 3",
      "caption": "Figure 3. Overview of the proposed Visual Speaker Authentication pipeline. (a) The Mixedfake Lip Generation module synthesizes pseudo-fake samples by mixing real lip frames to emulate high- and low-frequency artifacts via Self-Mixed Lip (SML) and Cross-Mixed Lip (CML). (b) The generated samples are processed by a visual encoder and a lightweight adapter (two fully connected layers), optimized through asymmetric contrastive learning and Gaussian Distribution Matching (GDM) to produce a compact latent feature space. (c) Finally, a density-based anomaly detector models the inlier distribution and excludes forgeries or human impostors during authentication.",
      "page": 3,
      "captionRect": [
        58.20399856567383,
        208.9642791748047,
        554.6253051757812,
        261.83441162109375
      ],
      "score": 32,
      "scoreReasons": [
