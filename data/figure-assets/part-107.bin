  {
    "id": "cvpr26-09c51ea3c27f",
    "extraction": {
      "id": "cvpr26-09c51ea3c27f",
      "figure": "Figure 2",
      "caption": "Figure 2. Overview of training phase of our framework. Given a query sample xq and its corresponding support samples {xs k}K k=1 (normal), we first leverage a frozen encoder E on query and support inputs, obtaining query patch features Fq and support patch features {Fs k}K k=1. Next, residual patch features R are computed by the NN search and element-wise subtraction. Subsequently, we apply several learnable proxies P to capture the pattern of residual R, obtaining residual proxies bP in the RFL module. In the next NLS module, bP aims to learn normality from support embeddings by comparing with residual, and the output of NLS is named as normality proxies eP that can hunt potential normality from query features, achieving anomaly localization.",
      "page": 3,
      "captionRect": [
        58.499969482421875,
        351.208984375,
        553.5008544921875,
        419.80035400390625
      ],
      "score": 47,
      "scoreReasons": [
        "framework:+9",
        "overview:+7",
        "encoder:+2",
        "module:+3",
        "architecture in caption lead:+12",
        "named model overview:+14"
