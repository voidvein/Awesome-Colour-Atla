      ],
      "captionFontSize": 8.97,
      "source_url": "https://openaccess.thecvf.com/content/CVPR2026/papers/Shu_LiteVGGT_Boosting_Vanilla_VGGT_via_Geometry-aware_Cached_Token_Merging_CVPR_2026_paper.pdf",
      "sourcePdf": "research/batch500/cache/cvpr26-007634981f16.pdf",
      "image": "research/batch500/candidates/cvpr26-007634981f16/cvpr26-007634981f16.png",
