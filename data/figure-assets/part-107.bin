      ],
      "captionFontSize": 8.97,
      "source_url": "https://openaccess.thecvf.com/content/CVPR2026/papers/Chen_Think_with_3D_Geometric_Imagination_Grounded_Spatial_Reasoning_from_Limited_CVPR_2026_paper.pdf",
      "sourcePdf": "research/batch500/cache/cvpr26-c9ccce1cbb6e.pdf",
      "image": "research/batch500/candidates/cvpr26-c9ccce1cbb6e/cvpr26-c9ccce1cbb6e.png",
