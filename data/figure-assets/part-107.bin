  {
    "id": "cvpr26-65bd691cfda5",
    "extraction": {
      "id": "cvpr26-65bd691cfda5",
      "figure": "Figure 2",
      "caption": "Figure 2. Our method introduces four simple yet critical updates to MAE, with following motivations. Web-scale training data with self- curation: IN-1K focuses on centered objects and lacks the spatial diversity needed for learning dense representations. Deeper decoder: MAE’s shallow decoder lacks capacity for predicting diverse spatial structures , forcing the encoder to sacrifice representation quality for spatial reconstruction. Larger mask block: single-patch masking causes spatial reconstruction shortcuts and provides insufficient context. More [CLS] tokens: a single class token cannot capture diverse global properties of spatial structure.",
      "page": 3,
      "captionRect": [
        58.5,
        277.13311767578125,
        553.4991455078125,
        330.016357421875
      ],
      "score": 14,
      "scoreReasons": [
        "encoder:+2",
        "decoder:+2",
        "multiple computational-mechanism cues:+10"
      ],
      "captionFontSize": 8.97,
