    "extraction": {
      "id": "cvpr26-007634981f16",
      "figure": "Figure 2",
      "caption": "Figure 2. Architecture Overview. We augment VGGT by placing a Geometry-aware Token Merging module on both sides of its global attention. Within GA-merge, tokens are partitioned by the GA map, grouped and merged to reduce redundancy, and after global attention the merged tokens are unmerged back to the original layout and passed to the subsequent frame-attention layers.",
      "page": 3,
      "captionRect": [
        58.5,
        237.1682586669922,
        553.4993286132812,
        270.2135314941406
      ],
      "score": 32,
